# Copy the names you need into your MCP client config or shell. Never commit values.

# Penpot base URL. Default https://design.penpot.app; self-hosted: your PENPOT_PUBLIC_URI.
PENPOT_BASE_URL=
# Personal access token: Penpot > Your account > Access tokens > Generate new token.
PENPOT_ACCESS_TOKEN=
# File id the move check (scripts/prove/penpot-move.sh) draws into: the "penpot-mcp test" file.
PENPOT_TEST_FILE_ID=
# Optional, for exports only: Penpot's exporter takes a login session, not a token.
# A Google or SSO account has no password: leave these empty and set
# PENPOT_MCP_URL, and exports render in the connected tab instead.
# Read once at start, held in memory, never logged.
PENPOT_EMAIL=
PENPOT_PASSWORD=
# Optional, for the tools that need a Penpot tab (execute_code, reflow, markup, CSS):
# Your account > Integrations > MCP Server. The whole URL, key included. A secret.
PENPOT_MCP_URL=
